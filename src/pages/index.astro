---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TreeNode from '../components/TreeNode.astro';
import { buildBlogTree } from '../utils/tree';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Fetch all markdown posts and convert to tree structure
const allPosts = await getCollection('blog');
const blogTree = buildBlogTree(allPosts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="tree-container">
			<div class="marquee" role="presentation">
				<span>★ Welcome to my homepage ★ 欢迎光临 ★ Best viewed at 800×600 with Netscape Navigator ★ This site is under construction ★</span>
			</div>

			<header class="page-header">
				<h1>📁 Outline</h1>
			</header>

			<section class="tree-wrapper">
				<ul class="root-tree">
					{blogTree.map((node) => <TreeNode node={node} />)}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tree-container {
		/* override global `main { width: 720px }` which forces horizontal overflow on mobile */
		width: auto;
		box-sizing: border-box;
		max-width: 800px;
		margin: 2em auto;
		padding: 1.5rem;
	}
	.marquee {
		margin-bottom: 1.5rem;
	}
	.page-header {
		margin-bottom: 1.5rem;
		border-bottom: 2px groove var(--silver);
		padding-bottom: 0.75rem;
	}
	.page-header h1 {
		font-size: 1.5rem;
		color: var(--navy);
		margin: 0;
	}
	/* file-manager directory view: sunken white well */
	.tree-wrapper {
		background: var(--white);
		border: 2px solid;
		border-color: var(--silver-dark) var(--white) var(--white) var(--silver-dark);
		padding: 1rem;
	}
	.root-tree {
		padding: 0;
		margin: 0;
	}
	@media (max-width: 720px) {
		.tree-container {
			margin: 1em auto;
			padding: 1rem 0.75rem;
		}
		.page-header {
			margin-bottom: 1rem;
		}
		.page-header h1 {
			font-size: 1.25rem;
		}
	}
</style>
