---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// posts published in the last 45 days get the classic blinking NEW! tag
const NEW_WINDOW_MS = 45 * 24 * 60 * 60 * 1000;
const isNew = (date: Date) => Date.now() - date.valueOf() < NEW_WINDOW_MS;
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 0.75rem);
				box-sizing: border-box;
				padding: 6px;
				background: var(--silver);
				border: 2px solid;
				border-color: var(--white) var(--silver-dark) var(--silver-dark) var(--white);
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 0.5rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 1.45rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--navy);
				line-height: 1.2;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.new-tag {
				color: #cc0000;
				font-size: 0.7em;
				font-weight: bold;
				vertical-align: super;
				margin-left: 4px;
			}
			ul li a:hover .title {
				color: var(--link-hover);
			}
			ul li:hover {
				border-color: var(--silver-dark) var(--white) var(--white) var(--silver-dark);
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 1rem;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child .title {
					font-size: 1.25em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">
										{post.data.title}
										{isNew(post.data.pubDate) && <span class="blink new-tag">NEW!</span>}
									</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
