---
// src/components/TreeNode.astro
import TreeNode from "./TreeNode.astro";

interface Props {
    node: any;
}

const { node } = Astro.props;
---

<li class="tree-node">
    {
        node.isFolder ? (
            <details class="folder-details">
                <summary class="folder-title">
                    <span class="icon">📁</span>
                    <span class="folder-name">{node.name}</span>
                </summary>
                <ul class="tree-children">
                    {node.children.map((child: any) => (
                        <TreeNode node={child} />
                    ))}
                </ul>
            </details>
        ) : (
            <a href={`/blog/${node.data.id}`} class="file-link">
                <span class="icon">📄</span>
                <span class="file-title">{node.name}</span>
                {node.data.data.pubDate && (
                    <time class="pub-date">
                        {
                            new Date(node.data.data.pubDate)
                                .toISOString()
                                .split("T")[0]
                        }
                    </time>
                )}
            </a>
        )
    }
</li>

<style>
    .tree-node {
        list-style: none;
        margin: 4px 0;
    }
    .folder-details {
        margin-left: 4px;
    }
    .folder-title {
        cursor: pointer;
        font-weight: bold;
        font-size: 1rem;
        color: #000;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        min-height: 44px;
        box-sizing: border-box;
        list-style: none;
    }
    .folder-name {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }
    .folder-title::-webkit-details-marker {
        display: none;
    }
    .folder-title::after {
        content: "▾";
        margin-left: auto;
        font-size: 0.75rem;
        color: var(--silver-dark);
    }
    .folder-details:not([open]) .folder-title::after {
        transform: rotate(-90deg);
    }
    /* file-manager style highlight: navy bar, white text */
    .folder-title:hover,
    .file-link:hover {
        background: var(--navy);
        color: var(--white);
    }
    .file-link:hover .pub-date {
        color: var(--silver);
    }
    .tree-children {
        list-style: none;
        padding-left: 1.25rem;
        margin: 4px 0 4px 8px;
        border-left: 2px dotted var(--silver-dark);
    }
    .file-link {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #000;
        font-size: 0.95rem;
        padding: 6px 8px;
        min-height: 44px;
        box-sizing: border-box;
    }
    .file-title {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }
    .pub-date {
        font-family: 'Courier New', 'Courier', monospace;
        font-size: 0.8rem;
        color: rgb(var(--gray));
        margin-left: 8px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .icon {
        font-size: 0.9rem;
        flex-shrink: 0;
    }
    @media (max-width: 720px) {
        .tree-children {
            padding-left: 0.75rem;
            margin-left: 4px;
        }
    }
</style>
