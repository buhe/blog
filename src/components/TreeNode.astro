---
// src/components/TreeNode.astro
import TreeNode from "./TreeNode.astro";

interface Props {
    node: any;
}

const { node } = Astro.props;
---

<li class="tree-node">
    {
        node.isFolder ? (
            <details class="folder-details">
                <summary class="folder-title">
                    <svg class="icon" viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true">
                        <rect x="2" y="2" width="7" height="3" fill="#000"></rect>
                        <rect x="3" y="3" width="5" height="1" fill="#fff3a8"></rect>
                        <rect x="1" y="5" width="14" height="8" fill="#000"></rect>
                        <rect x="2" y="6" width="12" height="5" fill="#ffd75e"></rect>
                        <rect x="2" y="11" width="12" height="1" fill="#caa53a"></rect>
                    </svg>
                    <span class="folder-name">{node.name}</span>
                </summary>
                <ul class="tree-children">
                    {node.children.map((child: any) => (
                        <TreeNode node={child} />
                    ))}
                </ul>
            </details>
        ) : (
            <a href={`/blog/${node.data.id}`} class="file-link">
                <svg class="icon" viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true">
                    <rect x="3" y="1" width="10" height="14" fill="#000"></rect>
                    <rect x="4" y="2" width="8" height="12" fill="#fff"></rect>
                    <rect x="5" y="4" width="6" height="1" fill="#000080"></rect>
                    <rect x="5" y="6" width="6" height="1" fill="#808080"></rect>
                    <rect x="5" y="8" width="6" height="1" fill="#808080"></rect>
                    <rect x="5" y="10" width="4" height="1" fill="#808080"></rect>
                </svg>
                <span class="file-title">{node.name}</span>
                {node.data.data.pubDate && (
                    <time class="pub-date">
                        {
                            new Date(node.data.data.pubDate)
                                .toISOString()
                                .split("T")[0]
                        }
                    </time>
                )}
            </a>
        )
    }
</li>

<style>
    .tree-node {
        list-style: none;
        margin: 0;
    }
    .folder-details {
        margin: 0;
    }
    .folder-title,
    .file-link {
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 20px;
        padding: 1px 4px;
        font-size: 13px;
        line-height: 1.4;
        user-select: none;
    }
    .folder-title {
        cursor: pointer;
        font-weight: bold;
        color: #000;
    }
    .folder-name,
    .file-title {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }
    .folder-title::-webkit-details-marker {
        display: none;
    }
    .folder-title {
        list-style: none;
    }
    /* classic +/- expand box */
    .folder-title::before {
        content: "+";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 11px;
        height: 11px;
        flex-shrink: 0;
        font-size: 10px;
        font-weight: bold;
        line-height: 1;
        color: #000;
        background: var(--silver);
        border: 1px solid;
        border-color: var(--silver-dark) var(--white) var(--white) var(--silver-dark);
    }
    .folder-details[open] > .folder-title::before {
        content: "−";
        background: conic-gradient(
            #dfdfdf 25%,
            #c0c0c0 0 50%,
            #dfdfdf 0 75%,
            #c0c0c0 0
        );
        background-size: 2px 2px;
    }
    /* file-manager style highlight: navy bar, white text */
    .folder-title:hover,
    .file-link:hover {
        background: var(--navy);
        color: var(--white);
    }
    .file-link:hover .pub-date {
        color: var(--silver);
    }
    .file-link {
        text-decoration: none;
        color: #000;
    }
    .tree-children {
        list-style: none;
        padding-left: 12px;
        margin: 0 0 0 8px;
        border-left: 1px dotted var(--silver-dark);
    }
    .pub-date {
        font-family: 'Courier New', 'Courier', monospace;
        font-size: 11px;
        color: rgb(var(--gray));
        margin-left: 8px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .icon {
        flex-shrink: 0;
        margin-right: 2px;
    }
    @media (max-width: 720px) {
        .tree-children {
            padding-left: 10px;
            margin-left: 5px;
        }
    }
</style>
