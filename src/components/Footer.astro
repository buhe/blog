---
const today = new Date();
// playful deterministic "hit counter": grows a little every day since the site began
const epoch = Date.UTC(2021, 7, 8); // first post era: Aug 8, 2021
const visits = String(Math.floor((Date.now() - epoch) / 86400000) * 7 + 1336).padStart(7, '0');
---

<footer>
	<div class="retro-row">
		You are visitor No. <span class="lcd">{visits}</span>
		<span class="badge">800×600</span>
		<span class="badge">16-BIT COLOR</span>
		<span class="badge">MADE WITH ASTRO</span>
	</div>
	<div class="statusbar">
		<span class="status-field grow">Done</span>
		<span class="status-field">&copy; {today.getFullYear()} buhe. All rights reserved.</span>
	</div>
</footer>
<style>
	footer {
		background: transparent;
		color: var(--silver-light);
		text-align: center;
	}
	.retro-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 6px;
		font-size: 12px;
		padding: 1.5em 1em 1em 1em;
	}
	.statusbar {
		position: sticky;
		bottom: 0;
		display: flex;
		gap: 4px;
		padding: 3px 4px;
		background: var(--silver);
		border-top: 1px solid var(--white);
		box-shadow: 0 -1px 0 var(--silver-dark);
	}
	.status-field {
		display: inline-block;
		padding: 2px 8px;
		font-size: 12px;
		color: #000;
		background: var(--silver);
		border: 1px solid;
		border-color: var(--silver-dark) var(--white) var(--white) var(--silver-dark);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.grow {
		flex: 1;
	}
</style>
